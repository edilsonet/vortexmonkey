# ============================================================
# VORTEX — Variáveis de Ambiente (MODELO)
# Copie para .env e preencha:  cp .env.example .env
# NUNCA commite o .env real (ver .gitignore)
# Gere segredos fortes com: openssl rand -base64 32
# ============================================================

# --- Banco de Dados (PostgreSQL 16) ---
POSTGRES_USER=change_me_postgres_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=vortex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://change_me_postgres_user:change_me_postgres_password@localhost:5432/vortex

# --- Cache (Redis 7) ---
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# --- Mensageria (RabbitMQ) ---
RABBITMQ_USER=vortex
RABBITMQ_PASSWORD=change_me_rabbitmq_password
RABBITMQ_URL=amqp://vortex:change_me_rabbitmq_password@localhost:5672

# --- Armazenamento (MinIO S3) ---
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ACCESS_KEY=change_me_minio_user
MINIO_SECRET_KEY=change_me_minio_password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET_DOCUMENTS=vortex-documents
MINIO_BUCKET_CERTIFICATES=vortex-certificates

# --- Segurança / Autenticação ---
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
TWO_FACTOR_ISSUER=VORTEX

# --- Ledger (Ed25519) — gerar com: openssl genpkey -algorithm ed25519 ---
LEDGER_PRIVATE_KEY=change_me_ledger_private_key
LEDGER_PUBLIC_KEY=change_me_ledger_public_key

# --- Integrações (opcionais nas Fases 1-3; stubs declarados) ---
ASAAS_API_KEY=change_me_asaas_api_key
RESEND_API_KEY=change_me_resend_api_key
SENTRY_DSN=change_me_sentry_dsn

# --- Observabilidade ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=change_me_otlp_endpoint

# --- Backup ---
BACKUP_RETENTION_DAYS=30