{
  "name": "shell-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "vx",
  "sourceRoot": "apps/shell-web/src",
  "tags": ["scope:shell", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/shell-web",
        "index": "apps/shell-web/src/index.html",
        "main": "apps/shell-web/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/shell-web/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui/src/styles"]
        },
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shell-web/public"
          }
        ],
        "styles": ["apps/shell-web/src/styles.scss"],
        "customWebpackConfig": {
          "path": "apps/shell-web/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "14kb",
              "maximumError": "18kb"
            }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "apps/shell-web/webpack.prod.config.ts"
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:module-federation-dev-server",
      "configurations": {
        "production": {
          "buildTarget": "shell-web:build:production"
        },
        "development": {
          "buildTarget": "shell-web:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4300,
        "publicHost": "http://localhost:4300",
        "proxyConfig": "apps/shell-web/proxy.conf.json",
        "allowedHosts": [".monkeycode-ai.live"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/apps/shell-web"
      }
    }
  }
}
