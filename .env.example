# VORTEX v4 — exemplo de configuração local. NAO commite valores reais.
# Copie para .env e preencha. Todos os segredos vem de ambiente/secret manager.

# Banco (PostgreSQL 16)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vortex
DB_ADMIN_USER=vortex_admin
DB_ADMIN_PASSWORD=troque-este-valor
DB_APP_USER=vortex_app
# Sem DB_APP_PASSWORD o runner de migracoes nao altera a senha do papel de
# aplicacao. Em dev o runtime usa o default `dev-app-password` do DatabaseService.
DB_APP_PASSWORD=troque-este-valor

# Cache / idempotencia / rate limit
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Vazio = sem senha (dev). Em producao use uma senha forte.
REDIS_PASSWORD=

# API
PORT=3400
# Porta publicada no host pelo docker compose (a `PORT` acima e a porta interna
# do processo; esta e o mapeamento). Ver docker-compose*.yml.
API_PORT=3400
# Tag das imagens (`vortex-ops-mro` e `vortex-mro-web`) usada pelo compose. O
# default e `dev` no docker-compose.yml e `prod` no docker-compose.prod.yml.
IMAGE_TAG=dev
# Porta publicada no host pelo servico `web` (frontend mro-web) em producao.
# A UI fica em http://SEU_IP:WEB_PORT e faz proxy de /api para a API.
WEB_PORT=8080
# `true` aplica `tools/seed-dev.mjs` no boot do container (apenas dev/showcase).
SEED_ON_BOOT=false

# Bootstrap do administrador de producao (primeiro acesso numa VPS limpa).
# Sem ele nao existe usuario e o login retorna 401. Rode UMA vez com
# BOOTSTRAP_ON_BOOT=true (ou `make prod-bootstrap` com o container no ar) e
# depois volte para `false`. Idempotente: reexecutar nao duplica nada e nao
# troca a senha viva (use BOOTSTRAP_RESET_PASSWORD=true para redefinir).
BOOTSTRAP_ON_BOOT=false
ADMIN_EMAIL=
ADMIN_NAME=
# CPF (11 digitos) e CNPJ (14 digitos) sao identificadores legais unicos.
ADMIN_CPF=
# Minimo 12 caracteres, combinando ao menos 3 classes. NAO commite a senha
# real: passe por variavel de ambiente ou `ADMIN_PASSWORD_FILE`.
ADMIN_PASSWORD=
TENANT_NAME=
# ERP | RH | CRM | LOJA | OPERADORES | MANUTENCAO | INSTRUCAO
TENANT_TYPE=MANUTENCAO
COMPANY_CNPJ=
COMPANY_NAME=
COMPANY_TRADE_NAME=
BOOTSTRAP_RESET_PASSWORD=false

# Autenticacao (JWT HS256)
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-valor
JWT_TTL_SECONDS=3600
JWT_ISSUER=vortex
JWT_AUDIENCE=vortex-api
# Validade do refresh token (rotativo). 30 dias por padrao.
# REFRESH_TTL_SECONDS=2592000
# Contexto provisorio por cabecalho (x-user-id/x-tenant-id). Deixe `false` em
# producao: o acesso deve exigir Bearer token. Sem a variavel, o padrao do
# codigo e ativo fora de producao e proibido em producao.
# AUTH_ALLOW_HEADER_CONTEXT=false

# Negocio
# ATENCAO: o docker compose usa estas variaveis para localizar o arquivo NO
# HOST ao montar os secrets (docker-compose.prod.yml). Devem apontar para o
# caminho de host gerado por `make ledger-key` (`.secrets/`). Dentro do
# container o caminho e fixado pelo compose em `/run/secrets/`, independente
# destes valores. Copiar `.env.example` como esta (com `/run/secrets/...`)
# faria o compose procurar a chave no host em `/run/secrets/` e falhar.
LEDGER_PRIVATE_KEY_FILE=./.secrets/ledger_ed25519.pem
LEDGER_PUBLIC_KEY_FILE=./.secrets/ledger_ed25519.pub

# Infra local via docker compose (docker-compose.yml)
RABBITMQ_USER=vortex
RABBITMQ_PASSWORD=troque-este-valor
# URL usada pelo publicador do outbox. Ausente = eventos ficam so no banco.
RABBITMQ_URL=amqp://vortex:troque-este-valor@127.0.0.1:5672
# Ritmo do worker do outbox (opcional)
# OUTBOX_BATCH_SIZE=50
# OUTBOX_POLL_MS=1000
# Teto de tentativas do outbox: ao atingir, o evento e abandonado (nao some do banco)
# OUTBOX_MAX_ATTEMPTS=10
# Consumidor de eventos (opcional): fila de retry, teto de tentativas e prefetch
# CONSUMER_RETRY_MS=10000
# CONSUMER_MAX_ATTEMPTS=5
# CONSUMER_PREFETCH=10
# Monitor do bus: intervalo e limiares de atraso do outbox (segundos)
# BUS_MONITOR_MS=30000
# OUTBOX_LAG_WARN_SECONDS=300
# OUTBOX_LAG_CRITICAL_SECONDS=1800
MINIO_ROOT_USER=vortex
MINIO_ROOT_PASSWORD=troque-este-valor
# Endpoint e alias usados por backup.sh/restore.sh para falar com o MinIO.
# Em dev (porta publicada): http://127.0.0.1:9000. Em producao o MinIO nao
# publica portas; exponha-o em loopback ou rode o backup dentro da rede do
# compose para que o host alcance este endpoint.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ALIAS=vortex
# Retencao local dos arquivos de backup (dias) antes da limpeza automatica.
BACKUP_RETENTION_DAYS=30
