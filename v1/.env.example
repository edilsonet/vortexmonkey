NODE_ENV=development
PORT=3000
APP_BASE_URL=http://api.vortex.localhost:3000
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vortex
DB_USER=vortex_app
DB_PASSWORD_FILE=/run/vortex-secrets/postgres-app
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD_FILE=/run/vortex-secrets/redis
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=vortex
RABBITMQ_PASSWORD_FILE=/run/vortex-secrets/rabbitmq
JWT_SECRET_FILE=/run/vortex-secrets/jwt
JWT_ISSUER=vortex.local
JWT_AUDIENCE=vortex-api
LEDGER_PRIVATE_KEY_FILE=/run/vortex-secrets/ledger-private.pem
LEDGER_PUBLIC_KEY_FILE=/run/vortex-secrets/ledger-public.pem
OTEL_EXPORTER_OTLP_ENDPOINT=
